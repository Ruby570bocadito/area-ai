# Base de datos SQLite
# IMPORTANTE: usa una ruta ABSOLUTA. Las rutas relativas (file:../db/…) se
# resuelven de forma distinta entre `prisma db push` y el cliente en runtime.
DATABASE_URL="file:./db/custom.db"

# Opcional: proveedor LLM compatible OpenAI (también configurable desde /modelos)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# Opcional: puerto del laboratorio HTTP real (por defecto 4403, bind en 127.0.0.1)
# LAB_PORT=4403

# Opcional: URL pública del sitio para Open Graph/Twitter (solo si se despliega; por defecto http://localhost:3000)
# NEXT_PUBLIC_SITE_URL=https://mi-dominio.com
# Opcional: PROTECCIÓN DE MUTACIONES. Si se define, los POST de
# /api/campaigns, /api/autopilot, /api/settings y /api/models exigen el token
# vía cabecera X-Admin-Token o cookie admin_token (ver README, Seguridad).
# Sin definir, la app queda en modo local abierto (caso soportado).
# ADMIN_TOKEN=cambia-esto-por-un-secreto-largo

# Opcional: CONFIANZA EN PROXY. Solo si la app está detrás de un proxy de
# confianza (p. ej. el Caddyfile de este repo, que fija X-Forwarded-For con
# la IP real), define TRUST_PROXY=1 para que la clave del rate limit use
# X-Forwarded-For. Sin él, esa cabecera se IGNORA (cualquier cliente podría
# suplantarla y rotar la clave para anular el límite) y el rate limit pasa
# a ser global por proceso.
# TRUST_PROXY=1
