# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
# (todos los ficheros de registro quedan cubiertos por *.log:
# dev.log, server.log, dev.out.log, etc.)
*.log
test
prompt

# Skills directory
/skills/
# local database
*.db
# internal tool outputs
/tool-results/
# agent/environment artifacts (not part of the product)
/.zscripts/
# borradores y volcados de los agentes (protocolo v2 §4)
/.agent-tmp/
/download/
/scripts/*.png
*.pid
# generated documentation assets are versioned, but keep raw captures out
!/docs/screenshots/

.agent-tmp/
